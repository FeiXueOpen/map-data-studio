                "maxLength": 200
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "sourceUrl": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "sourceTitle": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "field",
