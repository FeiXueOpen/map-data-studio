  {
    "name": "get_default_export_format",
    "description": "读取默认景区导出格式：以用户杭州表格34列表头为标准，返回列顺序、字段键、样式及格式约定。无需本地模板文件。用fields检查get_template_gaps并附来源补齐，之后export_excel生成标准景区数据表及完整原始附表。用户指定另一模板时以用户模板为准。 返回enrichmentPolicy：AI导出默认逐项研究票价、预约、时间和攻略；无需用户另说补票价。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "filter_pois",
    "description": "按AI指定字段条件、排序与数量筛选当前已加载范围，返回可用于后续补全和导出的selectionId。limit可为10、50等；sortBy数字字段缺失排除并报告。评分不能冒充客流，客流需先回填有来源且口径可比的数字字段。仅覆盖当前数据集，不保证城市真实前N。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "childrenOnly": {
          "type": "boolean"
        },
        "includeChildren": {
          "type": "boolean"
        },
        "poiIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "sortBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "order": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "filters": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "operator": {
                "type": "string",
                "enum": [
                  "eq",
                  "contains",
                  "not_contains",
                  "gte",
                  "lte",
                  "is_missing",
                  "not_missing"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "field",
              "operator"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "instruction",
        "limit"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "create_poi_selection",
    "description": "接收AI基于用户要求制定的有序景区名单与数量。依据可标为ai_recommendation、user_specified；推荐名单不是实测客流排名。附理由和可选公开来源。返回selectionId，供补全、缺项检查、模板导出复用。不会修改纳入选项。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "childrenOnly": {
          "type": "boolean"
        },
        "includeChildren": {
          "type": "boolean"
        },
        "poiIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "basis": {
          "type": "string",
          "enum": [
            "ai_recommendation",
            "user_specified"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "evidence": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "sourceUrl": {
                "type": "string",
                "maxLength": 1000
              },
              "sourceTitle": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "id",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "poiIds",
        "instruction",
        "basis"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "get_poi_selection",
