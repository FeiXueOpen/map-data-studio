  {
    "name": "create_supplement_task",
    "description": "建立景区导出补全任务，省略fields默认检查杭州标准34字段，返回默认AI补全规则及分组缺项（含票价、预约、时间、攻略）。AI客户端按规则联网查证后用supplement_pois回填，MCP本身不运行模型。 支持fieldRules逐列指令、类型、字数及票价格式；返回合并后的实际规则。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "childrenOnly": {
          "type": "boolean"
        },
        "includeChildren": {
          "type": "boolean"
        },
        "poiIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "selectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": "可选；省略时采用杭州标准表全部34字段，默认包含各票种、费用、预约和攻略，不仅补简介。指定其他模板时传入全部映射字段。"
        },
        "fieldRules": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "instruction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "valueType": {
                "type": "string",
                "enum": [
                  "text",
                  "number"
                ]
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "format": {
                "type": "string",
                "enum": [
                  "ticketPrice",
                  "original"
                ]
              }
            },
            "required": [
              "field",
              "instruction"
            ],
            "additionalProperties": false
          },
          "description": "逐列AI补填规则，覆盖同字段默认规则。类型、字数及ticketPrice格式在任务批量回填时校验；自然语言由AI执行。相同字段不同列需要不同内容时使用不同custom字段。"
        }
      },
      "required": [
        "instruction"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
