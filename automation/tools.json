  {
    "name": "download_images",
    "description": "用户明确要求联网补图时调用，默认每点3张，原图保存。百度使用内置 Playwright 浏览器：ratio传原生比例分类imgratio，size传尺寸分类z，width/height传自定义搜索尺寸；这些均为搜索筛选，不是下载后裁剪或缩放。数字比例3:4映射竖图分类，不保证结果精确3:4；需要精确尺寸可传width/height，原图不匹配时跳过并报告不足。get_status.imageBrowserStatus.awaiting_user时提示用户完成验证；等待整体操作和imageResults再报告保存数量。 一个批次共用同一浏览器，默认每次搜索间隔8秒。页面资源未加载或验证超时时停止本批次。 可用selectionId复用AI的筛选范围及顺序。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "ratio": {
          "type": "string",
          "pattern": "^(original|tall|portrait|square|landscape|wide|[1-9][0-9]{0,3}:[1-9][0-9]{0,3})$",
          "description": "百度原生比例分类，original为全部比例；数字比例映射相应分类，非裁剪参数"
        },
        "engine": {
          "type": "string",
          "enum": [
            "bing",
            "baidu"
          ]
        },
        "minWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "parentId": {
          "type": "string",
          "minLength": 1
        },
        "poiIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "includeChildren": {
          "type": "boolean"
        },
        "childrenOnly": {
          "type": "boolean"
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6000,
          "description": "百度自定义搜索尺寸，宽高同时传，0不指定；不对图片做缩放。"
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6000,
          "description": "百度自定义搜索尺寸，宽高同时传，0不指定；不对图片做缩放。"
        },
        "minHeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6000,
          "description": "图片最小高度，默认0"
        },
        "size": {
          "type": "string",
          "enum": [
            "all",
            "small",
            "medium",
            "large",
            "wallpaper"
          ],
          "description": "百度原生尺寸分类，默认all；自定义宽高优先"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 3,
          "maximum": 60,
          "description": "同一浏览器批次中景区搜索间隔，默认8秒"
        },
        "proxy": {
          "type": "string",
          "maxLength": 2000,
          "description": "可选图片浏览器代理，未指定使用客户端设置；不含账号密码"
        },
        "selectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
