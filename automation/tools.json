      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "parentId": {
          "type": "string",
          "minLength": 1
        },
        "manual": {
          "type": "boolean",
          "description": "仅用户明确要求手动圈选时为 true，默认 false 优先 AOI"
        }
      },
      "required": [],
